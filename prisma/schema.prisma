// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

model Booking {
  id         String        @id @default(cuid())
  guestName  String
  email      String
  phone      String
  guests     Int
  checkIn    DateTime
  checkOut   DateTime
  nights     Int
  totalPrice Float
  message    String?
  status     BookingStatus @default(pending)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model BlockedRange {
  id        String   @id @default(cuid())
  start     DateTime
  end       DateTime
  reason    String?
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

model ExternalCalendar {
  id            String    @id @default(cuid())
  name          String
  icalUrl       String
  lastSyncedAt  DateTime?
  lastSyncError String?
  lastSyncCount Int?
  createdAt     DateTime  @default(now())
}

model Settings {
  id              Int      @id @default(1)
  pricePerNight   Float    @default(75)
  cleaningFee     Float    @default(35)
  minNights       Int      @default(2)
  currency        String   @default("EUR")
  contactEmail    String   @default("entrevigasapartamentosdm@gmail.com")
  contactPhone    String   @default("+34 634 218 140")
  icalExportToken String   @default("")
  baseGuests      Int      @default(2)
  maxGuests       Int      @default(6)
  heroTitle       String   @default("")
  heroSubtitle    String   @default("")
  aboutText       String   @default("")
  updatedAt       DateTime @updatedAt
}

// Precio por noche para un mes concreto (1 = enero ... 12 = diciembre).
// Si un mes no tiene fila, se usa Settings.pricePerNight.
model SeasonalRate {
  month         Int   @id
  pricePerNight Float
}

// Recargo porcentual sobre el precio de las noches (no sobre la limpieza)
// para un número de huéspedes concreto. Los huéspedes <= Settings.baseGuests
// no llevan recargo. Ej: { guests: 4, percent: 20 } = +20% con 4 huéspedes.
model GuestRate {
  guests  Int   @id
  percent Float
}

model Photo {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  alt       String   @default("")
  section   String   @default("galeria") // "hero" | "galeria"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
